rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // amsociety.in — submissions
    // read/update/delete restricted to the document owner. create is permitted for
    // unauthenticated form writers (legacy public-form flow); if the writer IS
    // authenticated, they must claim their own uid as the `uid` field on the doc.
    match /submissions/{docId} {
      allow create: if request.auth == null
                    || request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.uid;
    }

    // amsderive.in — registrants
    match /registrants/{docId} {
      allow create: if false;
      allow read: if false;
      // Admin only: update status field only
      allow update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['status']);
      allow delete: if false;
    }

    // amsderive.in — rate limiting
    // ⚠️ CRITICAL: Only Admin SDK can write. Clients have zero write access to prevent rate limit bypass.
    // Rule: allow read, write: if false blocks all clients. Admin SDK bypasses rules entirely.
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }
    match /_rate_limits_email/{docId} {
      allow read, write: if false;
    }
    match /_rate_limits_handle/{docId} {
      allow read, write: if false;
    }

    // amsderive.in — firm partner accounts
    // All reads/writes go through Admin SDK in API routes. No client SDK access permitted.
    match /firms/{uid} {
      allow read, write: if false;
    }

    // amsderive.in — per-institution registration counters
    // Written by Admin SDK only (one doc per university slug, no single-doc hotspot).
    match /stats_inst/{docId} {
      allow read, write: if false;
    }

    // Codeforces handle sentinel docs — Admin SDK only (duplicate prevention)
    match /cfHandles/{docId} {
      allow read, write: if false;
    }

    // Pre-registration interest emails — Admin SDK only
    match /pre_registrations/{docId} {
      allow read, write: if false;
    }

    // Audit log — Admin SDK only; never accessible by clients
    match /_audit_log/{docId} {
      allow read, write: if false;
    }

    // Webhook deduplication IDs — Admin SDK only
    match /_webhook_ids/{docId} {
      allow read, write: if false;
    }

    // Per-institution registration counters (stats_inst) — written by Admin SDK increment
    // Already covered above; this alias ensures future collection group queries are denied
    match /stats/{docId} {
      allow read, write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}